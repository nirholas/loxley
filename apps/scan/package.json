{
  "name": "@loxley/scan",
  "version": "0.1.0",
  "private": true,
  "description": "Loxley Scan: the x402 settlement explorer for Robinhood Chain. Indexes every Permit2-proxy settlement, ranks facilitators, payees and payers, and serves both an API and a UI.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "index": "tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@loxley/chain": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "hono": "^4.7.0",
    "viem": "^2.48.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
