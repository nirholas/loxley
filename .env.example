# Copy to .env. Every value here has a working default except the private keys.

# Robinhood Chain RPCs. Public endpoints are rate-limited; put an Alchemy/QuickNode URL here for production.
RHC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Facilitator signer: needs ETH on the chain it settles on (gas for settle() and sponsored approvals).
FACILITATOR_PRIVATE_KEY=0x
# Which networks this facilitator serves (comma-separated CAIP-2). Default: both.
FACILITATOR_NETWORKS=eip155:4663,eip155:46630
FACILITATOR_PORT=4663
# Persist the discovery catalog + settlement journal here (SQLite).
FACILITATOR_DB=./data/facilitator.db

# Contract deployer (forge scripts).
DEPLOYER_PRIVATE_KEY=0x

# Explorer indexer.
SCAN_DB=./data/scan.db
SCAN_PORT=4664
SCAN_NETWORK=eip155:4663
